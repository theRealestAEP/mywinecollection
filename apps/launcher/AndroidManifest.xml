<?xml version="1.0" encoding="utf-8"?>
<!-- Cellar: Wine Portraits for an Android tablet, the book full screen. It can
     be the tablet's home app, so the Home button and a restart open the book. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.therealestaep.wineportraits"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Cellar"
        android:icon="@mipmap/icon"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".BookActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
